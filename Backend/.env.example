# NEURIX — Backend Environment Variables
# Copy this file to .env and fill in your values.
# The .env file is NOT committed to git.
# ─────────────────────────────────────────────

# ── AI: Google Gemini (cloud fallback) ─────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── AI: Anthropic Claude (optional cloud fallback) ─
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── AI: Ollama (local, offline LLM) ────────────
# Install Ollama from https://ollama.ai and run a model locally.
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_HEALTH_URL=http://localhost:11434/api/tags
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_TIMEOUT=90

# ── JWT Authentication ──────────────────────────
# Use a strong random string. Generate with: openssl rand -hex 32
SECRET_KEY=your-strong-random-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=72

# ── Database ────────────────────────────────────
DATABASE_URL=sqlite:///./neurix.db

# ── Email (Gmail SMTP for OTP delivery) ─────────
# Use a Gmail App Password (not your main password).
# See: https://support.google.com/accounts/answer/185833
GMAIL_SENDER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# ── Alert Recipient ──────────────────────────────
ALERT_EMAIL_RECIPIENT=alerts@yourdomain.com

# ── Google Maps (optional, for routing features) ──
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ── Application Metadata ────────────────────────
PROJECT_NAME=NEURIX Tactical Intelligence
VERSION=2.0.0
