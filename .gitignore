# ─────────────────────────────────────────────
# NEURIX — .gitignore
# Covers: React Native / Expo / TypeScript / Node.js / Python / FastAPI
# ─────────────────────────────────────────────

# ── Environment & Secrets ──────────────────────
.env
.env.*
!.env.example
Backend/.env
SatelliteBackend/.env

# ── Node / NPM ──────────────────────────────────
node_modules/
npm-debug.*
yarn-debug.*
yarn-error.*
.npm/

# ── Expo ───────────────────────────────────────
.expo/
.expo-home/
dist/
web-build/
expo-env.d.ts
*.jsbundle

# ── React Native / Native Build ────────────────
/ios/
/android/
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.keystore

# ── Metro ─────────────────────────────────────
.metro-health-check*

# ── Python ────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
.Python
venv/
.venv/
env/
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
*.egg-info/
dist/
build/
.mypy_cache/
.dmypy.json
dmypy.json

# ── Databases (local SQLite) ──────────────────
*.db
*.sqlite
*.sqlite3

# ── Logs ──────────────────────────────────────
*.log
logs/
*.log.*
npm-debug.log*

# ── Temporary / Debug Artifacts ───────────────
tmp/
*.tmp
build_error*.txt
bundle_error.json
bundle_test.js
doctor_*.txt
metro_*.txt
tsc_errors*.txt
error.json
*.zip
seed_log.txt

# ── Sensitive Data Dumps ──────────────────────
users_list*.txt
tactical_key.txt
tactical_audit.json
Backend/users_list*.txt
Backend/tactical_*.txt
Backend/tactical_*.json

# ── IDE / Editor ──────────────────────────────
.vscode/
.idea/
*.expo.code-workspace
*.swp
*.bak
*~
.DS_Store
Thumbs.db

# ── TypeScript ────────────────────────────────
*.tsbuildinfo

# ── macOS / Windows ───────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Old / Generated files ─────────────────────
app-example/
api_old.py
