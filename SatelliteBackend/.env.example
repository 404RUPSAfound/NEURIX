# NEURIX Satellite Tile Service — Environment Variables
# Copy this file to .env and fill in your values.
# The .env file is NOT committed to git.
# ─────────────────────────────────────────────

# ── Server ─────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── NASA GIBS (Free — No API key required) ──────
# Available layers: VIIRS_SNPP_CorrectedReflectance_TrueColor, MODIS_Aqua_CorrectedReflectance_TrueColor

# ── Sentinel Hub (Copernicus Sentinel-2) ────────
# Register at: https://www.sentinel-hub.com/ to obtain these credentials.
SENTINEL_CLIENT_ID=your_sentinel_client_id_here
SENTINEL_CLIENT_SECRET=your_sentinel_client_secret_here
SENTINEL_INSTANCE_ID=your_sentinel_instance_id_here

# ── Tile Cache ──────────────────────────────────
CACHE_TTL=86400
CACHE_MAX_KEYS=1000

# ── MongoDB (optional — falls back to in-memory) ─
MONGODB_URI=mongodb://localhost:27017/neurix_intel
